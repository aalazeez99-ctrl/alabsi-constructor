---
import { getImage } from 'astro:assets';
import { useTranslations, altPath, CONTACT } from '../i18n/ui.js';
import ogSource from '../assets/og.png';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/global.css';

/* `title`/`description` let sub-pages (project details) override the
   site defaults; `altHref` lets them point the language switch at their
   own counterpart rather than the home page. */
const {
  lang = 'ar',
  title: titleOverride,
  description: descOverride,
  altHref: altHrefOverride,
} = Astro.props;

const t = useTranslations(lang);

const pageTitle = titleOverride ?? t.meta.title;
const pageDesc = descOverride ?? t.meta.description;
const langAltHref = altHrefOverride ?? altPath(lang);

/* Nav items are same-page anchors like "#services". On a sub-page those
   anchors point at nothing, so prefix them with the home path there. */
const homeBase = lang === 'en' ? '/en/' : '/';
const navPrefix = Astro.url.pathname === homeBase ? '' : homeBase;

const site = Astro.site ?? new URL('https://alabsi-alahliah.com');
const canonical = new URL(Astro.url.pathname, site).href;

/* Social preview card.
   The source is a 1.7 MB PNG. WhatsApp — the way most of this site's
   links will actually be shared — silently drops previews above roughly
   300 KB, so the raw file must never be the og:image. sharp re-encodes
   it to a ~1200px JPEG at build time, which lands comfortably under
   that limit and is the format every scraper handles best. */
const OG_WIDTH = 1200;
const OG_HEIGHT = Math.round(OG_WIDTH * (ogSource.height / ogSource.width));

const ogCard = await getImage({
  src: ogSource,
  width: OG_WIDTH,
  format: 'jpeg',
  quality: 78,
});
const ogImage = new URL(ogCard.src, site).href;

/* Structured data. This — not the keywords meta tag — is what actually
   drives rich results and local/Maps eligibility in Kuwait. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${new URL('/', site).href}#organization`,
  name: t.brand.legalName,
  alternateName:
    lang === 'ar'
      ? 'Alabsi Alahliah Building Construction Co.'
      : 'العبسي الأهلية للمقاولات والتشطيبات',
  url: canonical,
  image: ogImage,
  logo: new URL('/logo.png', site).href,
  telephone: CONTACT.phoneHref,
  email: CONTACT.email,
  description: t.meta.description,
  slogan: `${t.hero.titleTop} ${t.hero.titleAccent}`,
  foundingDate: '2018',
  knowsLanguage: ['ar', 'en'],
  currenciesAccepted: 'KWD',

  address: {
    '@type': 'PostalAddress',
    addressLocality: lang === 'ar' ? 'الشويخ' : 'Shuwaikh',
    addressRegion: lang === 'ar' ? 'محافظة العاصمة' : 'Al Asimah Governorate',
    addressCountry: 'KW',
  },

  /* Coordinates are for the Shuwaikh district. Replace with the exact
     office location once confirmed — see README. */
  geo: { '@type': 'GeoCoordinates', latitude: 29.3375, longitude: 47.92 },

  areaServed: [
    { '@type': 'Country', name: 'Kuwait' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'محافظة العاصمة' : 'Al Asimah' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'حولي' : 'Hawalli' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'الفروانية' : 'Al Farwaniyah' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'الأحمدي' : 'Al Ahmadi' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'مبارك الكبير' : 'Mubarak Al-Kabeer' },
    { '@type': 'AdministrativeArea', name: lang === 'ar' ? 'الجهراء' : 'Al Jahra' },
  ],

  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.services.heading,
    itemListElement: t.services.items.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.text },
    })),
  },

  sameAs: Object.values(CONTACT.social).filter((u) => u && u !== '#'),
};
---
<!DOCTYPE html>
<html lang={t.htmlLang} dir={t.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#062A33" />
  <meta name="generator" content={Astro.generator} />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="keywords" content={t.meta.keywords} />
  <link rel="canonical" href={canonical} />

  {/* Local/geo signals for Kuwait */}
  <meta name="geo.region" content="KW-KU" />
  <meta name="geo.placename" content={lang === 'ar' ? 'الشويخ، الكويت' : 'Shuwaikh, Kuwait'} />
  <meta name="geo.position" content="29.3375;47.9200" />
  <meta name="ICBM" content="29.3375, 47.9200" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  {/* Real per-language URLs — this is what a JS-only language toggle can never give you. */}
  <link rel="alternate" hreflang="ar" href={new URL(lang === 'ar' ? Astro.url.pathname : langAltHref, site).href} />
  <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? Astro.url.pathname : langAltHref, site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={t.brand.legalName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {/* Explicit dimensions make renderers show a large card instead of
      falling back to a small thumbnail while they measure the file. */}
  <meta property="og:image:width" content={String(OG_WIDTH)} />
  <meta property="og:image:height" content={String(OG_HEIGHT)} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content={t.brand.legalName} />
  <meta property="og:locale" content={t.meta.ogLocale} />
  <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_KW'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />

  {/* logo.png is served straight from public/ — never resized or re-encoded. */}
  <link rel="icon" href="/logo.png" type="image/png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>

<body>
  <Preloader t={t} />

  <a class="skip-link" href="#main">{t.skip}</a>

  <Icons />
  <Header lang={lang} t={t} altHref={langAltHref} navPrefix={navPrefix} />

  <main id="main">
    <slot />
  </main>

  <Footer lang={lang} t={t} navPrefix={navPrefix} />
  <Floating t={t} />

  <script src="../scripts/site.js"></script>
</body>
</html>
