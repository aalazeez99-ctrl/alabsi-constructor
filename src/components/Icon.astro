---
/**
 * Renders one icon from the sprite.
 *
 * @prop name  - symbol name without the "i-" prefix, e.g. "phone"
 * @prop size  - "sm" (20px, default) | "lg" (28px)
 * @prop dir   - true for arrows that must flip in RTL
 * @prop class - extra classes
 */
const { name, size = 'sm', dir = false, class: extra = '' } = Astro.props;

const classes = ['ico', size === 'lg' && 'ico-lg', dir && 'ico-dir', extra]
  .filter(Boolean)
  .join(' ');
---
<svg class={classes} aria-hidden="true" focusable="false"><use href={`#i-${name}`}></use></svg>
