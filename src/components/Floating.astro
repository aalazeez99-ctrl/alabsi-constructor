---
import Icon from './Icon.astro';
import { CONTACT } from '../i18n/ui.js';
const { t } = Astro.props;
---
<a
  class="fab fab-wa"
  href={`https://wa.me/${CONTACT.whatsapp}`}
  target="_blank"
  rel="noopener"
  aria-label={t.fab.whatsapp}
>
  <Icon name="whatsapp" size="lg" />
</a>

<button type="button" class="fab fab-top" id="toTop" aria-label={t.fab.top} hidden>
  <Icon name="arrow-up" />
</button>
